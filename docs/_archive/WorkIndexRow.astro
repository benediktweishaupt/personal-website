---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const GRID_COLS = 'grid-cols-[72px_1fr_48px] sm:grid-cols-[72px_1fr_1fr_1fr_48px]';

const { project } = Astro.props;
const d = project.data;

const isCaseStudy = d.template === 'case-study';
const isGraduation = !!d.student;
const isClickable = d.projectAudience !== 'none';
const href = `/projects/${project.id}`;
---

<div
  class:list={[
    'project-row group grid relative -mx-page gap-x-4 px-page py-1 pb-6 border-b border-gray-600 transition-colors',
    isClickable && 'hover:bg-gray-50',
    GRID_COLS,
  ]}
  data-row
  data-title={d.title.toLowerCase()}
  data-year={d.meta.year ?? ''}
  data-category={d.meta.category}
  data-institution={(d.meta.institution ?? '').toLowerCase()}
  data-thumbnail-audience={d.thumbnailAudience ?? 'all'}
  data-project-audience={d.projectAudience ?? 'all'}
>
  {/* Cover thumbnail — height matches 3 lines of text-sm (3 × 1.25rem = 3.75rem) */}
  <div class="flex items-start pt-1">
    {isClickable && d.cover?.image && (
      <Image
        src={d.cover.image}
        alt=""
        class="w-full aspect-[4/3] object-cover rounded-none grayscale group-hover:grayscale-0 transition-[filter] duration-300"
        loading="lazy"
        width={216}
        densities={[1, 2]}
        quality={80}
        format="webp"
      />
    )}
  </div>

  {/* Title */}
  <div class="min-w-0">
    {isClickable ? (
      <a href={href} class="stretched-link block truncate text-sm text-gray-900">
        {d.title}{isGraduation && d.student && ` (${d.student})`}
      </a>
    ) : (
      <span class="block truncate text-sm text-gray-400">
        {d.title}{isGraduation && d.student && ` (${d.student})`}
      </span>
    )}
  </div>

  {/* Description */}
  <div class:list={["text-sm hidden sm:block", isClickable ? "text-gray-900" : "text-gray-400"]}>
    <span class="desc-clamp">{d.description ?? ''}</span>
  </div>

  {/* Institution */}
  <div class:list={["text-sm truncate hidden sm:flex items-start", isClickable ? "text-gray-900" : "text-gray-400"]}>{d.meta.institution ?? ''}</div>

  {/* Year */}
  <div class:list={["text-sm tabular-nums flex items-start", isClickable ? "text-gray-900" : "text-gray-400"]}>{d.meta.year ?? ''}</div>
</div>

<style>
  .stretched-link::after {
    position: absolute;
    inset: 0;
    content: '';
    z-index: 1;
  }
  .desc-clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
