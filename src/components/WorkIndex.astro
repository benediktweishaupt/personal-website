---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import WorkIndexRow from './WorkIndexRow.astro';

const GRID_COLS = 'grid-cols-[54px_1fr_60px] sm:grid-cols-[54px_1fr_80px_60px] md:grid-cols-[54px_1fr_80px_120px_60px] lg:grid-cols-[54px_1fr_80px_120px_1fr_60px] xl:grid-cols-[54px_1fr_80px_120px_1fr_60px_60px_70px_30px_30px_30px]';

export interface Props {
  filter?: 'all' | 'blog' | 'projects';
}

const { filter = 'all' } = Astro.props;

const allProjects = filter !== 'blog'
  ? (await getCollection('projects', (p) =>
      p.data.status !== 'hidden' && !(import.meta.env.PROD && p.data.status === 'draft')
    ))
  : [];

// Cards: case-study template items
const cardProjects = allProjects
  .filter((p) => p.data.template === 'case-study')
  .sort((a, b) => a.data.order - b.data.order);

// Sort weight: case-study first, then graduation, then rest
function sortWeight(d: { template?: string; student?: string }): number {
  if (d.template === 'case-study') return 0;
  if (d.student) return 2;
  return 1;
}

const tableProjects = [...allProjects].sort((a, b) => {
  const yearA = a.data.meta.year ?? '0';
  const yearB = b.data.meta.year ?? '0';
  const numA = parseInt(yearA.match(/\d{4}/)?.[0] ?? '0');
  const numB = parseInt(yearB.match(/\d{4}/)?.[0] ?? '0');
  if (numB !== numA) return numB - numA;
  return sortWeight(a.data) - sortWeight(b.data);
});
---

<main class="max-w-screen-2xl mx-auto px-6 pt-20 pb-32 bg-white/70 backdrop-blur-xl">

  {/* ── Highlight Cards ── */}
  <h1 class="text-sm uppercase tracking-widest text-gray-400 pb-3">Case Studies</h1>

  <div class="flex gap-3 overflow-x-auto pb-8 -mx-6 px-6 snap-x snap-mandatory">
    {cardProjects.map((project) => (
      <article class="shrink-0 w-64 sm:w-80 md:w-96 bg-white rounded-sm  overflow-hidden group snap-start transition-all duration-200" data-card data-thumbnail-audience={project.data.thumbnailAudience ?? 'all'}>
        <a href={`/projects/${project.id}`}>
          {project.data.cover?.image && (
            <div class="aspect-[3/4] bg-gray-100 overflow-hidden opacity-80 group-hover:opacity-100">
              <Image
                src={project.data.cover.image}
                alt={project.data.cover.alt ?? ''}
                class="w-full h-full object-cover transition-transform duration-300"
                loading="lazy"
                widths={[320, 640]}
              />
            </div>
          )}
          <div class="p-4">
            <p class="text-sm text-gray-400 tracking-wide group-hover:text-gray-500">
              {project.data.meta.institution ?? project.data.meta.category} · {project.data.meta.year}
            </p>
            <h2 class="text-base font-medium text-gray-600 group-hover:text-gray-700">{project.data.title}</h2>
            {project.data.description && <p class="text-sm text-gray-400 group-hover:text-gray-500 mt-1 line-clamp-2">{project.data.description}</p>}
          </div>
        </a>
      </article>
    ))}
  </div>

  {/* ── Project Table ── */}
  <div class="mt-8">
    <h1 class="text-sm uppercase text-gray-400 pb-3">All Projects</h1>

    {/* Filter pills */}
    <div class="flex gap-2 pb-4 flex-wrap" id="filter-pills">
      <button data-filter="all" class="filter-pill active rounded-full px-3 py-1 text-sm transition-colors">All</button>
      <button data-filter="clients" class="filter-pill rounded-full px-3 py-1 text-sm transition-colors">Clients</button>
      <button data-filter="research" class="filter-pill rounded-full px-3 py-1 text-sm transition-colors">Research</button>
      <button data-filter="teaching" class="filter-pill rounded-full px-3 py-1 text-sm transition-colors">Teaching</button>
    </div>

    {/* Table header */}
    <div class:list={[
      'grid gap-x-4 px-6 py-2 -mx-6 text-sm uppercase text-gray-600 border-b border-gray-600 sticky top-0 bg-white/90 backdrop-blur-sm z-10 select-none',
      GRID_COLS,
    ]}>
      <div></div>
      <button data-sort="title" class="sort-btn text-left hover:text-gray-600 transition-colors">Title</button>
      <button data-sort="category" class="sort-btn text-left hover:text-gray-600 transition-colors hidden sm:block">Category</button>
      <button data-sort="format" class="sort-btn text-left hover:text-gray-600 transition-colors hidden md:block">Format</button>
      <button data-sort="institution" class="sort-btn text-left hover:text-gray-600 transition-colors hidden lg:block">Institution</button>
      <button data-sort="year" data-dir="desc" class="sort-btn text-left hover:text-gray-600 transition-colors">Year <span class="sort-indicator">↓</span></button>
      <button data-sort="status" class="sort-btn text-left hover:text-gray-600 transition-colors hidden xl:block">Status <span class="sort-indicator">↓</span></button>
      <button data-sort="projectAudience" class="sort-btn text-left hover:text-gray-600 transition-colors hidden xl:block">Access <span class="sort-indicator">↓</span></button>
      <button data-sort="cover" class="sort-btn text-left hover:text-gray-600 transition-colors hidden xl:block">Cover <span class="sort-indicator">↓</span></button>
      <button data-sort="desc" class="sort-btn text-left hover:text-gray-600 transition-colors hidden xl:block">Desc <span class="sort-indicator">↓</span></button>
      <button data-sort="body" class="sort-btn text-left hover:text-gray-600 transition-colors hidden xl:block">Body <span class="sort-indicator">↓</span></button>
    </div>

    {/* Table rows */}
    <div id="project-list">
      {tableProjects.map((project) => <WorkIndexRow project={project} />)}
    </div>

    {/* Count */}
    <p id="project-count" class="text-xs text-gray-400 mt-4 px-4">
      {tableProjects.length} projects
    </p>
  </div>
</main>

<style>
  .filter-pill {
    @apply text-gray-400 bg-transparent border border-gray-200;
  }
  .filter-pill:hover {
    @apply text-gray-600 border-gray-300;
  }
  .filter-pill.active {
    @apply text-gray-700 bg-white border-gray-300 shadow-sm;
  }

  .sort-indicator {
    @apply text-gray-300 ml-0.5;
  }
  .sort-btn[data-dir="asc"] .sort-indicator,
  .sort-btn[data-dir="desc"] .sort-indicator {
    @apply text-gray-600;
  }
  .sort-btn:not([data-dir]) .sort-indicator { display: none; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.getElementById('project-list');
    const countEl = document.getElementById('project-count');
    if (!list) return;

    const rows = () => [...list.querySelectorAll<HTMLElement>('[data-row]')];

    // ── Sort ──
    document.querySelectorAll<HTMLElement>('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        if (!key) return;

        const prev = btn.dataset.dir;
        document.querySelectorAll<HTMLElement>('.sort-btn').forEach(b => delete b.dataset.dir);
        const dir = prev === 'asc' ? 'desc' : 'asc';
        btn.dataset.dir = dir;

        const indicator = btn.querySelector('.sort-indicator');
        if (indicator) indicator.textContent = dir === 'asc' ? '↑' : '↓';

        const sorted = rows().sort((a, b) => {
          const av = a.dataset[key] || '';
          const bv = b.dataset[key] || '';
          if (key === 'year') {
            const na = parseInt(av.match(/\d{4}/)?.[0] ?? '0');
            const nb = parseInt(bv.match(/\d{4}/)?.[0] ?? '0');
            return dir === 'asc' ? na - nb : nb - na;
          }
          return dir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
        });
        sorted.forEach(r => list.appendChild(r));
      });
    });

    // ── Audience ──
    const audience = localStorage.getItem('portfolio-audience') || 'all';

    function canSee(thumbAud: string) {
      return audience === 'family' || thumbAud === 'all' || thumbAud === audience;
    }

    // Filter cards by audience
    document.querySelectorAll<HTMLElement>('[data-card]').forEach(card => {
      if (!canSee(card.dataset.thumbnailAudience || 'all')) card.style.display = 'none';
    });

    // ── Filter ──
    function applyFilters() {
      const activePill = document.querySelector('.filter-pill.active') as HTMLElement | null;
      const cat = activePill?.dataset.filter || 'all';
      let visible = 0;
      rows().forEach(r => {
        const catMatch = cat === 'all' || r.dataset.category === cat;
        const audMatch = canSee(r.dataset.thumbnailAudience || 'all');
        r.style.display = catMatch && audMatch ? '' : 'none';
        if (catMatch && audMatch) visible++;
      });
      if (countEl) countEl.textContent = `${visible} projects`;
    }

    // Initial audience filter
    applyFilters();

    document.querySelectorAll<HTMLElement>('.filter-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
    });
  });
</script>
