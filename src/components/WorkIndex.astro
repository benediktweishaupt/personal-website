---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

export interface Props {
  filter?: 'all' | 'blog' | 'projects';
}

const { filter = 'all' } = Astro.props;

const projects = filter !== 'blog'
  ? (await getCollection('projects', (p) => p.data.status !== 'hidden'))
      .sort((a, b) => a.data.order - b.data.order)
  : [];

const posts = filter !== 'projects'
  ? (await getCollection('blog', (p) => p.data.status !== 'hidden'))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  : [];
---

<main class="max-w-screen-2xl mx-auto px-6 py-20 bg-gray-200/70  backdrop-blur-lg">
  <h1 class="pb-1">Case Studies</h1>

  <div class="flex gap-2 overflow-x-auto pb-4 -mx-6 px-6 snap-x snap-mandatory">
    {projects.map((project) => (
      <article class="shrink-0 w-64 sm:w-80 md:w-96 bg-slate-50 rounded-sm hover:rounded-2xl overflow-hidden group snap-start">
        <a href={`/projects/${project.id}`}>
          <div class="aspect-[3/4] bg-gray-100 overflow-hidden">
            <img
              src={`/image/${project.data.cover.image}.jpg`}
              alt={project.data.cover.alt ?? ''}
              class="w-full h-full object-cover transition-transform duration-300"
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-400 tracking-wide group-hover:text-gray-500">
              {project.data.meta.institution ?? project.data.meta.category} · {project.data.meta.year}
            </p>
            <h2 class="text-base font-medium text-gray-600 group-hover:text-gray-700">{project.data.title}</h2>
            {project.data.description && <p class="text-sm text-gray-400 group-hover:text-gray-500 mt-1">{project.data.description}</p>}
          </div>
        </a>
      </article>
    ))}
  </div>
  <h1 class="pb-1">Project Lists</h1>
  <h1 class="pb-1">Stories</h1>

  <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

    {posts.map((post) => (
      <article>
        <a href={`/blog/${post.id}/`} class="block hover:bg-slate-50 rounded-sm p-4">
          <p class="text-sm font-medium text-gray-800 tracking-wide">
            <FormattedDate date={post.data.pubDate} />
          </p>
          <h2 class="text-base font-medium text-gray-800">{post.data.title}</h2>
          {post.data.excerpt && <p class="text-base font-medium text-gray-400">{post.data.excerpt}</p>}
        </a>
      </article>
    ))}
  </div>
</main>