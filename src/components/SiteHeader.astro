---
export interface Props {
	pageTitle?: string;
}

const { pageTitle } = Astro.props;
const path = Astro.url.pathname;
const onCaseStudies = path === '/' || path === '';
const onIndex = path.startsWith('/archive');
const onAbout = path.startsWith('/about');
const onSubpage = !onCaseStudies && !onIndex && !onAbout;
const inactiveTab = "bg-gray-200 text-gray-400 hover:text-gray-900 shadow-[inset_0_-4px_8px_rgba(0,0,0,0.06)]";
const activeTab = "tab-active text-gray-900 bg-white";
---

<div class="sticky top-0 z-50">
	<header class="h-10 flex items-center justify-between px-page bg-gray-100 shadow-[inset_0_-4px_8px_rgba(0,0,0,0.06)]">
		<nav transition:name="site-nav" transition:animate="morph" class="flex items-center h-full gap-0.5 pt-1">
			<a href="/" class:list={[
				"flex items-center h-full px-4 text-sm rounded-t-xl transition-colors",
				onCaseStudies ? activeTab : inactiveTab
			]}>Case Studies</a>
			<a href="/archive" class:list={[
				"flex items-center h-full px-4 text-sm rounded-t-xl transition-colors",
				onIndex ? activeTab : inactiveTab
			]}>Index</a>
			<a href="/about" class:list={[
				"flex items-center h-full px-4 text-sm rounded-t-xl transition-colors",
				onAbout ? activeTab : inactiveTab
			]}>About</a>
			{onSubpage && pageTitle && (
				<a href="/" class:list={[
					"flex items-center justify-center h-full px-3 sm:justify-start sm:pl-4 sm:pr-3 text-sm rounded-t-xl gap-2 sm:max-w-[300px]",
					activeTab
				]} aria-label="Close tab">
					<span class="truncate hidden sm:inline">{pageTitle}</span>
					<span class="text-gray-400 hover:text-gray-900 transition-colors">&times;</span>
				</a>
			)}
		</nav>
		{onSubpage ? (
			<span class="text-sm text-gray-400 truncate">
				<span class="hidden lg:inline">Benedikt Weishaupt</span>
				<span class="hidden md:inline lg:hidden">Bndkt Wshpt</span>
				<span class="hidden sm:inline md:hidden">BW</span>
			</span>
		) : (
			<span class="text-sm text-gray-400 truncate">
				<span class="hidden md:inline">Benedikt Weishaupt</span>
				<span class="hidden sm:inline md:hidden">Bndkt Wshpt</span>
				<span class="sm:hidden">BW</span>
			</span>
		)}
	</header>
	<div class="h-2 bg-white"></div>
</div>

<style>
	.tab-active {
		position: relative;
		z-index: 1;
	}
	.tab-active::before,
	.tab-active::after {
		content: '';
		position: absolute;
		bottom: 0;
		width: 12px;
		height: 12px;
	}
	.tab-active::before {
		left: -12px;
		background: radial-gradient(circle at 0 0, transparent 12px, white 12px);
	}
	.tab-active::after {
		right: -12px;
		background: radial-gradient(circle at 100% 0, transparent 12px, white 12px);
	}
</style>
