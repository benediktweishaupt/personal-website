---
import { SITE_NAME } from '../consts';

export interface Props {
	pageTitle?: string;
}

const { pageTitle } = Astro.props;
const path = Astro.url.pathname;
const onIndex = path === '/' || path === '';
const onAbout = path.startsWith('/about');
const onSubpage = !onIndex && !onAbout;
const inactiveTab = "bg-gray-200 text-gray-400 hover:text-gray-900 shadow-[inset_0_-4px_8px_rgba(0,0,0,0.06)]";
const activeTab = "text-gray-900 bg-white";
---

<div class="sticky top-0 z-50">
	<header class="h-10 flex items-center justify-between px-6 bg-gray-100 shadow-[inset_0_-4px_8px_rgba(0,0,0,0.06)]">
		<nav transition:name="site-nav" transition:animate="morph" class="flex items-center h-full gap-0.5 pt-1">
			<a href="/" class:list={[
				"flex items-center h-full px-4 text-sm rounded-t-xl transition-colors",
				onIndex ? activeTab : inactiveTab
			]}>Index</a>
			<a href="/about" class:list={[
				"flex items-center h-full px-4 text-sm rounded-t-xl transition-colors",
				onAbout ? activeTab : inactiveTab
			]}>About</a>
			{onSubpage && pageTitle && (
				<span class:list={[
					"flex items-center h-full pl-4 pr-3 text-sm rounded-t-xl gap-2 max-w-[200px] sm:max-w-[300px]",
					activeTab
				]}>
					<span class="truncate">{pageTitle}</span>
					<a href="/" class="text-gray-400 hover:text-gray-900 transition-colors" aria-label="Close tab">&times;</a>
				</span>
			)}
		</nav>
		<span class="text-sm text-gray-400 truncate max-w-[200px] sm:max-w-[300px]">
			{SITE_NAME}
		</span>
	</header>
	<div class="h-2 bg-white"></div>
</div>
