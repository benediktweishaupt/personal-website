---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const GRID_COLS = 'grid-cols-[1fr_60px] sm:grid-cols-[1fr_90px_80px_60px] md:grid-cols-[1fr_90px_80px_120px_60px] lg:grid-cols-[1fr_90px_80px_120px_1fr_60px] xl:grid-cols-[1fr_90px_80px_120px_1fr_60px_60px_70px_30px_30px_30px]';

const { project } = Astro.props;
const d = project.data;

const isEntry = d.type === 'entry';
const isClickable = !isEntry;
const isCaseStudy = d.template === 'case-study';
const isGraduation = !!d.student;
const typeLabel = isCaseStudy ? 'Case Study' : isGraduation ? 'Graduation' : isEntry ? 'Entry' : 'Project';
const href = `/projects/${project.id}`;

const hasCover = !!(d.cover?.image);
const hasDesc = !!d.description;
const hasBody = !!(project.body?.trim());
---

<div
  class:list={[
    'project-row grid relative -mx-6 gap-x-4 px-6 py-2.5 border-b border-gray-600',
    isClickable && 'transition-colors hover:bg-gray-50',
    GRID_COLS,
  ]}
  data-row
  data-title={d.title.toLowerCase()}
  data-year={d.meta.year ?? ''}
  data-category={d.meta.category}
  data-format={(d.meta.format ?? '').toLowerCase()}
  data-institution={(d.meta.institution ?? '').toLowerCase()}
  data-type={typeLabel.toLowerCase()}
  data-status={d.status}
  data-audience={d.audience ?? 'all'}
  data-cover={hasCover ? '1' : '0'}
  data-desc={hasDesc ? '1' : '0'}
  data-body={hasBody ? '1' : '0'}
>
  {/* Title */}
  <div class="min-w-0">
    {isClickable ? (
      <a href={href} class="stretched-link block truncate text-sm text-gray-600">
        {d.title}{isGraduation && d.student && ` (${d.student})`}
      </a>
    ) : (
      <span class="block truncate text-sm text-gray-600">{d.title}</span>
    )}
    {isCaseStudy && d.description && (
      <p class="text-sm text-gray-400 truncate mt-0.5 hidden lg:block">{d.description}</p>
    )}
  </div>

  {/* Type */}
  <div class="text-sm text-gray-600 hidden sm:flex items-start">{typeLabel}</div>

  {/* Category */}
  <div class="text-sm text-gray-600 hidden sm:flex items-start capitalize">{d.meta.category}</div>

  {/* Format */}
  <div class="text-sm text-gray-600 truncate hidden md:flex items-start">{d.meta.format ?? ''}</div>

  {/* Institution */}
  <div class="text-sm text-gray-600 truncate hidden lg:flex items-start">{d.meta.institution ?? ''}</div>

  {/* Year */}
  <div class="text-sm text-gray-600 tabular-nums flex items-start">{d.meta.year ?? ''}</div>

  {/* Status */}
  <div class="text-sm text-gray-600 hidden xl:flex items-start">{d.status}</div>

  {/* Audience */}
  <div class="text-sm text-gray-600 hidden xl:flex items-start">{d.audience ?? 'all'}</div>

  {/* Cover */}
  <div class="text-sm text-gray-600 hidden xl:flex items-start">{hasCover ? '+' : ''}</div>

  {/* Desc */}
  <div class="text-sm text-gray-600 hidden xl:flex items-start">{hasDesc ? '+' : ''}</div>

  {/* Body */}
  <div class="text-sm text-gray-600 hidden xl:flex items-start">{hasBody ? '+' : ''}</div>
</div>

<style>
  .stretched-link::after {
    position: absolute;
    inset: 0;
    content: '';
    z-index: 1;
  }
</style>
