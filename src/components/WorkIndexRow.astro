---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const GRID_COLS = 'grid-cols-[54px_1fr_60px] sm:grid-cols-[54px_1fr_1fr_60px]';

const { project } = Astro.props;
const d = project.data;

const isCaseStudy = d.template === 'case-study';
const isGraduation = !!d.student;
const isClickable = d.projectAudience !== 'none';
const href = `/projects/${project.id}`;
---

<div
  class:list={[
    'project-row group grid relative -mx-6 gap-x-4 px-6 py-2.5 border-b border-gray-600 transition-colors',
    isClickable && 'hover:bg-gray-50',
    GRID_COLS,
  ]}
  data-row
  data-title={d.title.toLowerCase()}
  data-year={d.meta.year ?? ''}
  data-category={d.meta.category}
  data-institution={(d.meta.institution ?? '').toLowerCase()}
  data-thumbnail-audience={d.thumbnailAudience ?? 'all'}
  data-project-audience={d.projectAudience ?? 'all'}
>
  {/* Cover thumbnail */}
  <div class="flex items-center">
    {d.cover?.image && (
      <Image
        src={d.cover.image}
        alt=""
        class="w-full aspect-[4/3] object-cover rounded-sm grayscale group-hover:grayscale-0 transition-[filter] duration-300"
        loading="lazy"
        width={108}
      />
    )}
  </div>

  {/* Title */}
  <div class="min-w-0">
    {isClickable ? (
      <a href={href} class="stretched-link block truncate text-sm text-gray-600">
        {d.title}{isGraduation && d.student && ` (${d.student})`}
      </a>
    ) : (
      <span class="block truncate text-sm text-gray-400">
        {d.title}{isGraduation && d.student && ` (${d.student})`}
      </span>
    )}
    {isCaseStudy && d.description && (
      <p class="text-sm text-gray-400 truncate mt-0.5 hidden sm:block">{d.description}</p>
    )}
  </div>

  {/* Institution */}
  <div class="text-sm text-gray-600 truncate hidden sm:flex items-start">{d.meta.institution ?? ''}</div>

  {/* Year */}
  <div class="text-sm text-gray-600 tabular-nums flex items-start">{d.meta.year ?? ''}</div>
</div>

<style>
  .stretched-link::after {
    position: absolute;
    inset: 0;
    content: '';
    z-index: 1;
  }
</style>
