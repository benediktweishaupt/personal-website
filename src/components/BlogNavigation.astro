---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

export interface Props {
	currentPostId?: string;
}

const { currentPostId } = Astro.props;
---

<!-- Desktop Sidebar -->
<aside id="desktop-sidebar" class="hidden md:block fixed left-0 top-0 h-full w-80 bg-slate-50 border-r border-slate-200 overflow-y-auto z-10">
	<div class="p-6">
		<div class="flex justify-between items-center mb-6">
			<h2 class="text-lg font-semibold text-gray-800">All Posts</h2>
			<button id="close-sidebar" class="text-gray-500 hover:text-gray-700">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<div class="space-y-3">
			{posts.map((post) => (
				<article class={`${post.id === currentPostId ? 'bg-slate-100 border-slate-300' : ''}`}>
					<a href={`/blog/${post.id}/`} class="block hover:bg-slate-100 rounded-lg p-3 border border-transparent hover:border-slate-200">
						<h3 class="text-sm font-medium text-gray-800 leading-tight">{post.data.title}</h3>
						{post.data.excerpt && <p class="text-xs text-gray-600 mt-1 line-clamp-2">{post.data.excerpt}</p>}
						<p class="text-xs text-gray-500 mt-2">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</a>
				</article>
			))}
		</div>
	</div>
</aside>

<!-- Mobile Overlay -->
<div id="mobile-overlay" class="md:hidden fixed inset-0 bg-black bg-opacity-50 z-50 hidden">
	<div class="bg-white h-full overflow-y-auto">
		<div class="p-4">
			<div class="flex justify-between items-center mb-6">
				<h2 class="text-lg font-semibold text-gray-800">All Posts</h2>
				<button id="close-mobile-nav" class="text-gray-500 hover:text-gray-700">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				{posts.map((post) => (
					<article class="space-y-0">
						<a href={`/blog/${post.id}/`} class="block hover:drop-shadow-md hover:border-slate-100 hover:bg-slate-50 rounded-lg p-4">
							<h2 class="text-base font-medium text-gray-800">{post.data.title}</h2>
							{post.data.excerpt && <p class="text-base text-gray-800">{post.data.excerpt}</p>}
							<p class="text-base text-gray-800">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</a>
					</article>
				))}
			</div>
		</div>
	</div>
</div>

<script>
	// Toggle desktop sidebar
	const toggleSidebar = document.getElementById('toggle-sidebar');
	const closeSidebar = document.getElementById('close-sidebar');
	const desktopSidebar = document.getElementById('desktop-sidebar');

	function showSidebar() {
		desktopSidebar?.classList.remove('hidden');
	}

	function hideSidebar() {
		desktopSidebar?.classList.add('hidden');
	}

	toggleSidebar?.addEventListener('click', showSidebar);
	closeSidebar?.addEventListener('click', hideSidebar);

	// Toggle mobile overlay
	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	const closeMobileNav = document.getElementById('close-mobile-nav');
	const mobileOverlay = document.getElementById('mobile-overlay');

	function showMobileNav() {
		mobileOverlay?.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
	}

	function hideMobileNav() {
		mobileOverlay?.classList.add('hidden');
		document.body.style.overflow = 'auto';
	}

	mobileMenuBtn?.addEventListener('click', showMobileNav);
	closeMobileNav?.addEventListener('click', hideMobileNav);

	// Close mobile nav when clicking outside
	mobileOverlay?.addEventListener('click', (e) => {
		if (e.target === mobileOverlay) {
			hideMobileNav();
		}
	});
</script>