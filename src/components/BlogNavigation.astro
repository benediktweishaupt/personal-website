---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

export interface Props {
	currentPostId?: string;
}

const { currentPostId } = Astro.props;
---

<!-- Navigation Overlay -->
<div id="navigation-overlay" class="fixed inset-0 hidden z-50">
	<div class="h-full overflow-y-auto flex flex-col ">
		<div class="flex items-center justify-between px-4 py-3 bg-slate-100">
			<h2 class="text-base font-medium text-gray-800">All Posts</h2>
			<button id="close-navigation" class="text-gray-500 hover:text-gray-700">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<div class=" grow grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 bg-slate-400 bg-opacity-50 backdrop-blur-2xl">
			{posts.map((post) => (
				<article class="space-y-0">
					<a href={`/blog/${post.id}/`} class="block hover:drop-shadow-md hover:border-slate-100 hover:bg-slate-50 hover:bg-opacity-80 rounded-sm p-4">
						<p class="text-sm font-medium text-gray-800 tracking-wide">
							<FormattedDate date={post.data.pubDate} />
						</p>
						<h2 class="text-base font-medium text-gray-800">{post.data.title}</h2>
						{post.data.excerpt && <p class="text-base font-medium text-gray-400">{post.data.excerpt}</p>}
					</a>
				</article>
			))}
		</div>
	</div>
</div>

<script>
	// Toggle navigation overlay
	const menuBtn = document.getElementById('menu-btn');
	const closeNavigation = document.getElementById('close-navigation');
	const navigationOverlay = document.getElementById('navigation-overlay');

	function showNavigation() {
		navigationOverlay?.classList.remove('hidden');
		document.body.style.overflow = 'hidden';
	}

	function hideNavigation() {
		navigationOverlay?.classList.add('hidden');
		document.body.style.overflow = 'auto';
	}

	menuBtn?.addEventListener('click', showNavigation);
	closeNavigation?.addEventListener('click', hideNavigation);

	// Close navigation when clicking outside
	navigationOverlay?.addEventListener('click', (e) => {
		if (e.target === navigationOverlay) {
			hideNavigation();
		}
	});
</script>