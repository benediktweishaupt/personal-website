---
interface Props {
  variant?: 'default' | 'large';
}

const { variant = 'default' } = Astro.props;

const classes =
  variant === 'large'
    ? 'inline-block border border-gray-900 rounded-lg px-3 py-1.5 text-sm bg-white text-gray-900 tracking-wide'
    : 'inline-block border border-gray-700 rounded-md px-1.5 py-1 text-[0.625rem] text-white bg-gray-900 uppercase leading-none tracking-wider';
---

<span class={classes}>
  <slot />
</span>
