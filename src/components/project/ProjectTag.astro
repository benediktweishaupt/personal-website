---
interface Props {
  variant?: 'default' | 'large';
}

const { variant = 'default' } = Astro.props;

const classes =
  variant === 'large'
    ? 'inline-block border border-zinc-800 rounded-full px-3 py-1.5 text-sm text-zinc-800 tracking-wide'
    : 'inline-block border border-zinc-800 rounded-full px-3 pt-2 pb-1.5 text-xs text-zinc-800 uppercase leading-none tracking-wide';
---

<span class={classes}>
  <slot />
</span>
