---
interface Props {
  variant?: 'default' | 'large';
}

const { variant = 'default' } = Astro.props;

const classes =
  variant === 'large'
    ? 'inline-block border border-gray-700 rounded-full px-4 py-1.5 text-sm text-gray-700 tracking-wide'
    : 'inline-block border border-gray-700 rounded-full px-2 pt-1.5 pb-1 text-[0.625rem] text-gray-700 uppercase leading-none tracking-wider';
---

<span class={classes}>
  <slot />
</span>
