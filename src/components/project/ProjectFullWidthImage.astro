---
import ProjectCaption from './ProjectCaption.astro';

interface Props {
  src: string;
  alt?: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<div class="w-full">
  <img
    src={src}
    alt={alt ?? ''}
    class="w-full h-auto rounded"
    loading="lazy"
  />
  <ProjectCaption text={caption} />
</div>
