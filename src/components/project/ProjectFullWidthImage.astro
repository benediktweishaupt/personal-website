---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectCaption from './ProjectCaption.astro';

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<div class="w-full">
  {typeof src === 'string' ? (
    <img
      src={src}
      alt={alt ?? ''}
      class="w-full h-auto rounded"
      loading="lazy"
    />
  ) : (
    <Image
      src={src}
      alt={alt ?? ''}
      class="w-full h-auto rounded"
      loading="lazy"
    />
  )}
  <ProjectCaption text={caption} />
</div>
