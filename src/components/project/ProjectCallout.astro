---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<aside class="callout bg-black rounded-lg p-6 text-base md:text-xl max-w-3xl text-white">
  {label && <><span class="uppercase tracking-wide text-white">{label}</span><span class="mx-2">·</span></>}
  <slot />
</aside>

<style>
  .callout :global(p) {
    display: inline;
  }
</style>
