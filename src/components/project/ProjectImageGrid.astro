---
import UiCaption from './UiCaption.astro';

interface ImageItem {
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  images: ImageItem[];
  columns?: 1 | 2 | 3;
}

const { images, columns = 2 } = Astro.props;

const gridClasses: Record<number, string> = {
  1: 'grid grid-cols-1 gap-4',
  2: 'grid grid-cols-1 md:grid-cols-2 gap-4',
  3: 'grid grid-cols-1 md:grid-cols-3 gap-4',
};
---

<div class={gridClasses[columns]}>
  {images.map((img) => (
    <div>
      <img
        src={img.src}
        alt={img.alt ?? ''}
        class="w-full h-auto rounded outline outline-1 outline-gray-200"
        loading="lazy"
      />
      <UiCaption text={img.caption} />
    </div>
  ))}
</div>
