---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

{text && (
  <p class="text-sm text-zinc-400 mt-1 flex items-start gap-1">
    <svg class="w-3 h-3 mt-0.5 flex-shrink-0" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 10V2M6 2L2 6M6 2L10 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>{text}</span>
  </p>
)}
