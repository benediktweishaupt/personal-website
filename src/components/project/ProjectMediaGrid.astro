---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectCaption from './ProjectCaption.astro';

interface MediaItem {
  type: 'video' | 'image';
  src: string | ImageMetadata;
  alt?: string;
  caption?: string;
}

interface Props {
  items: MediaItem[];
  columns?: 1 | 2 | 3 | 4;
}

const { items, columns = 2 } = Astro.props;

const gridClasses: Record<number, string> = {
  1: 'grid grid-cols-1 gap-4',
  2: 'grid grid-cols-1 md:grid-cols-2 gap-4',
  3: 'grid grid-cols-1 md:grid-cols-3 gap-4',
  4: 'grid grid-cols-2 md:grid-cols-4 gap-4',
};
---

<div class={gridClasses[columns]}>
  {items.map((item) => (
    <div>
      {item.type === 'video' ? (
        <video
          src={item.src as string}
          class="w-full h-auto rounded outline outline-1 outline-gray-200"
          autoplay
          loop
          muted
          playsinline
        />
      ) : typeof item.src === 'string' ? (
        <img
          src={item.src}
          alt={item.alt ?? ''}
          class="w-full h-auto rounded outline outline-1 outline-gray-200"
          loading="lazy"
        />
      ) : (
        <Image
          src={item.src}
          alt={item.alt ?? ''}
          class="w-full h-auto rounded outline outline-1 outline-gray-200"
          loading="lazy"
        />
      )}
      <ProjectCaption text={item.caption} />
    </div>
  ))}
</div>
