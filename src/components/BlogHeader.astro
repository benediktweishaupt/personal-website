---
import { getCollection } from 'astro:content';
import { SITE_NAME } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

export interface Props {
	currentPostId?: string;
}

const { currentPostId } = Astro.props;

// Find current post index for prev/next navigation
const currentIndex = posts.findIndex(post => post.id === currentPostId);
const prevPost = currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? posts[currentIndex - 1] : null;
---

<header class="border-b border-slate-200 bg-slate-50 sticky top-0 z-20">
	<nav class="flex items-center justify-between px-4 py-3">
		<div class="flex items-center space-x-4">
			<!-- Navigation menu button -->
			<button id="menu-btn" class="text-gray-600 hover:text-gray-800">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>

			<!-- Site title -->
			<h1 class="text-base font-medium">
				<a href="/" class="hover:opacity-80">{SITE_NAME}</a>
			</h1>
		</div>

		<!-- Prev/Next Navigation -->
		<div class="flex items-center space-x-2">
			{prevPost ? (
				<a href={`/blog/${prevPost.id}/`} class="flex items-center px-3 py-1 text-sm text-gray-600 hover:text-gray-800 hover:bg-slate-50 rounded-md" title={prevPost.data.title}>
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span class="hidden sm:inline">Prev</span>
				</a>
			) : (
				<span class="flex items-center px-3 py-1 text-sm text-gray-300 cursor-not-allowed">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span class="hidden sm:inline">Prev</span>
				</span>
			)}

			{nextPost ? (
				<a href={`/blog/${nextPost.id}/`} class="flex items-center px-3 py-1 text-sm text-gray-600 hover:text-gray-800 hover:bg-slate-50 rounded-md" title={nextPost.data.title}>
					<span class="hidden sm:inline">Next</span>
					<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</a>
			) : (
				<span class="flex items-center px-3 py-1 text-sm text-gray-300 cursor-not-allowed">
					<span class="hidden sm:inline">Next</span>
					<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</span>
			)}
		</div>
	</nav>
</header>