---
import { getCollection } from 'astro:content';
import { SITE_NAME } from '../consts';
import FormattedDate from './FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

export interface Props {
	currentPostId?: string;
	prevHref?: string;
	nextHref?: string;
	prevTitle?: string;
	nextTitle?: string;
}

const { currentPostId, prevHref: customPrevHref, nextHref: customNextHref } = Astro.props;

// Blog post navigation (currentPostId takes priority)
const currentIndex = currentPostId !== undefined ? posts.findIndex(post => post.id === currentPostId) : -1;
const blogPrevPost = currentPostId !== undefined && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null;
const blogNextPost = currentPostId !== undefined && currentIndex > 0 ? posts[currentIndex - 1] : null;

// Resolved links — blog takes priority, then custom hrefs, then null (disabled)
const prevHref = currentPostId !== undefined
	? (blogPrevPost ? `/blog/${blogPrevPost.id}/` : null)
	: (customPrevHref ?? null);
const nextHref = currentPostId !== undefined
	? (blogNextPost ? `/blog/${blogNextPost.id}/` : null)
	: (customNextHref ?? null);

const showNav = currentPostId !== undefined || customPrevHref !== undefined || customNextHref !== undefined;
---

<header class="max-w-screen-2xl mx-auto sticky z-20 top-2 ">
	<nav class="flex items-center justify-between bg-white/70 backdrop-blur-lg mx-2 p-1 rounded-full ">
		<div class="flex items-center space-x-4 pl-4">
			<!-- Site title -->
			<h1 class="text-base font-medium font-serif italic">
				<a href="/" class="hover:opacity-80">{SITE_NAME}</a>
			</h1>
		</div>

		<!-- Prev/Next Navigation -->
		<div class="flex items-center space-x-2">
			{showNav && (prevHref ? (
				<a href={prevHref} class="flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800 hover:bg-slate-50 rounded-md">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span class="hidden sm:inline">Prev</span>
				</a>
			) : (
				<span class="flex items-center px-3 py-1.5 text-sm text-gray-300 cursor-not-allowed">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span class="hidden sm:inline">Prev</span>
				</span>
			))}

			{showNav && (nextHref ? (
				<a href={nextHref} class="flex items-center px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800 hover:bg-slate-50 rounded-md">
					<span class="hidden sm:inline">Next</span>
					<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</a>
			) : (
				<span class="flex items-center px-3 py-1.5 text-sm text-gray-300 cursor-not-allowed">
					<span class="hidden sm:inline">Next</span>
					<svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
					</svg>
				</span>
			))}

			<!-- Menu toggle button -->
			<button id="menu-toggle" class="text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-full p-2.5">
				<svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<!-- Navigation Overlay -->
<div id="navigation-overlay" class="fixed inset-0 hidden z-50 top-16 bottom-2  overflow-y-auto max-w-screen-2xl mx-auto rounded-3xl">
		<div class=" grow h-full grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 bg-white/70 backdrop-blur-lg">
			{posts.map((post) => (
				<article class="space-y-0">
					<a href={`/blog/${post.id}/`} class="block hover:drop-shadow-md hover:border-slate-100 hover:bg-slate-50 hover:bg-opacity-80 rounded-sm p-4">
						<p class="text-sm font-medium text-gray-800 tracking-wide">
							<FormattedDate date={post.data.pubDate} />
						</p>
						<h2 class="text-base font-medium text-gray-800">{post.data.title}</h2>
						{post.data.excerpt && <p class="text-base font-medium text-gray-400">{post.data.excerpt}</p>}
					</a>
				</article>
			))}
		</div>
</div>

<script>
	// Toggle navigation overlay and burger/cross icon
	const menuToggle = document.getElementById('menu-toggle');
	const navigationOverlay = document.getElementById('navigation-overlay');
	const hamburgerIcon = document.getElementById('hamburger-icon');
	const closeIcon = document.getElementById('close-icon');

	let isMenuOpen = false;

	function toggleMenu() {
		isMenuOpen = !isMenuOpen;

		if (isMenuOpen) {
			navigationOverlay?.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
			hamburgerIcon?.classList.add('hidden');
			closeIcon?.classList.remove('hidden');
		} else {
			navigationOverlay?.classList.add('hidden');
			document.body.style.overflow = 'auto';
			hamburgerIcon?.classList.remove('hidden');
			closeIcon?.classList.add('hidden');
		}
	}

	menuToggle?.addEventListener('click', toggleMenu);

	// Close navigation when clicking outside
	navigationOverlay?.addEventListener('click', (e) => {
		if (e.target === navigationOverlay) {
			toggleMenu();
		}
	});
</script>
