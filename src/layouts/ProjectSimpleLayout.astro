---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { AUTHOR_NAME } from '../consts';
import ProjectDescription from '../components/project/ProjectDescription.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import ProjectTagList from '../components/project/ProjectTagList.astro';

interface Props {
  title: string;
  projectId: string;
  projectAudience?: string;
  cover?: {
    image: ImageMetadata;
    alt?: string;
    caption?: string;
  };
  meta: {
    category: string;
    format?: string;
    team?: string;
    institution?: string;
    year?: string;
  };
  description?: string;
  description_de?: string;
  collaborators?: string;
  student?: string;
}

const { title, projectId, projectAudience, cover, meta, description, description_de, collaborators, student } = Astro.props;

// Meta items for the header
const metaItems = [
  meta.format,
  meta.institution,
  meta.team,
  collaborators && `with ${collaborators}`,
  student && `Student: ${student}`,
  meta.year,
].filter(Boolean);
---

<BaseLayout title={`${title} — ${AUTHOR_NAME}`} description={description ?? title}>
  <SiteHeader slot="header" pageTitle={title} />

  {cover?.image && (
    <div class="p-4">
      <div class="w-full h-[75vh] overflow-hidden rounded">
        <Image
          src={cover.image}
          alt={cover.alt ?? ''}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  )}



  <main class="max-w-screen-2xl mx-auto px-page pt-12 pb-20">
    {/* Header */}

    <ProjectSection variant="full" gap="10">

    {/* Description */}
    {description && (
        <ProjectDescription><span class="uppercase text-gray-400 mr-4">{title}</span>{description}</ProjectDescription>
    )}
    <ProjectTagList tags={metaItems as string[]} />
  </ProjectSection>


    {/* MDX body content (if any) */}
    <div class="pt-8">
      <slot />
    </div>
  </main>
  <script is:inline define:vars={{ projectAudience }}>
    document.addEventListener('astro:page-load', function() {
      var aud = localStorage.getItem('portfolio-audience') || 'all';
      if (aud === 'family' || projectAudience === 'all' || projectAudience === aud) return;
      window.location.replace('/');
    });
  </script>
</BaseLayout>
