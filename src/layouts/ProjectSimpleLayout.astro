---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { AUTHOR_NAME } from '../consts';

interface Props {
  title: string;
  projectId: string;
  projectAudience?: string;
  cover?: {
    image: ImageMetadata;
    alt?: string;
    caption?: string;
  };
  meta: {
    category: string;
    format?: string;
    team?: string;
    institution?: string;
    year?: string;
  };
  description?: string;
  description_de?: string;
  collaborators?: string;
  student?: string;
}

const { title, projectId, projectAudience, cover, meta, description, description_de, collaborators, student } = Astro.props;

// Meta items for the header
const metaItems = [
  meta.format,
  meta.institution,
  meta.team,
  collaborators && `with ${collaborators}`,
  student && `Student: ${student}`,
  meta.year,
].filter(Boolean);
---

<BaseLayout title={`${title} — ${AUTHOR_NAME}`} description={description ?? title}>
  <SiteHeader slot="header" pageTitle={title} />

  <main class="max-w-screen-2xl mx-auto px-7 pt-12 pb-20">
    {/* Header */}
    <div class="max-w-2xl">
      <h1 class="text-2xl font-medium text-gray-800">{title}</h1>
      <p class="text-sm text-gray-400 mt-2">{metaItems.join(' · ')}</p>
    </div>

    {/* Description */}
    {description && (
      <div class="max-w-2xl mt-8">
        <p class="text-base text-gray-600 leading-relaxed">{description}</p>
      </div>
    )}

    {/* Cover image */}
    {cover?.image && (
      <div class="mt-10">
        <Image
          src={cover.image}
          alt={cover.alt ?? ''}
          class="w-full max-h-[60vh] object-cover rounded-sm"
          loading="eager"
          fetchpriority="high"
        />
        {cover.caption && (
          <p class="text-xs text-gray-400 mt-2">{cover.caption}</p>
        )}
      </div>
    )}

    {/* MDX body content (if any) */}
    <div class="max-w-2xl mt-10 prose prose-gray">
      <slot />
    </div>
  </main>
  <script is:inline define:vars={{ projectAudience }}>
    document.addEventListener('astro:page-load', function() {
      var aud = localStorage.getItem('portfolio-audience') || 'all';
      if (aud === 'family' || projectAudience === 'all' || projectAudience === aud) return;
      window.location.replace('/projects');
    });
  </script>
</BaseLayout>
