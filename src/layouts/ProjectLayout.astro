---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { AUTHOR_NAME } from '../consts';

interface Props {
  title: string;
  projectId: string;
  status?: string;
  projectAudience?: string;
  cover?: {
    image: ImageMetadata;
    alt?: string;
    caption?: string;
  };
  meta: {
    category: string;
    format?: string;
    team?: string;
    institution?: string;
    year?: string;
  };
  description?: string;
}

const { title, projectId, projectAudience, cover, meta, description } = Astro.props;

---

<BaseLayout title={`${title} — ${AUTHOR_NAME}`} description={description ?? title}>
  <SiteHeader slot="header" pageTitle={title} />

  {cover?.image && (
    <div class="w-full h-[75vh]">
      <Image
        src={cover.image}
        alt={cover.alt ?? ''}
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}
  <main class="max-w-screen-2xl mx-auto px-7 pt-8 pb-20 flex flex-col gap-12">
    <slot />
  </main>
  <script is:inline define:vars={{ projectAudience }}>
    document.addEventListener('astro:page-load', function() {
      var aud = localStorage.getItem('portfolio-audience') || 'all';
      if (aud === 'family' || projectAudience === 'all' || projectAudience === aud) return;
      window.location.replace('/projects');
    });
  </script>
</BaseLayout>
