---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BlogHeader from '../components/BlogHeader.astro';
import { AUTHOR_NAME } from '../consts';

interface Props {
  title: string;
  projectId: string;
  status?: string;
  cover: {
    image: string;
    alt?: string;
    caption?: string;
  };
  meta: {
    category: string;
    format?: string;
    team?: string;
    institution?: string;
    year?: string;
  };
  description?: string;
}

const { title, projectId, cover, meta, description } = Astro.props;

// Compute project prev/next for header navigation
const allProjects = (await getCollection('projects', (p) => p.data.status !== 'hidden'))
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = allProjects.findIndex((p) => p.id === projectId);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

---

<BaseLayout title={`${title} — ${AUTHOR_NAME}`} description={description ?? title}>
  <BlogHeader
    slot="header"
    pageTitle={title}
    prevHref={prevProject ? `/projects/${prevProject.id}` : undefined}
    nextHref={nextProject ? `/projects/${nextProject.id}` : undefined}
  />

  {cover.image && (
    <div class="w-full">
      <img
        src={`/image/${cover.image}.jpg`}
        alt={cover.alt ?? ''}
        class="w-full h-auto"
        loading="eager"
        onerror="this.style.display='none'"
      />
      {cover.caption && (
        <p class="text-sm text-gray-400 px-7 mt-2">{cover.caption}</p>
      )}
    </div>
  )}
  <main class="max-w-screen-2xl mx-auto px-7 pt-8 pb-20 flex flex-col gap-12">
    <slot />
  </main>
</BaseLayout>
