---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BlogHeader from '../components/BlogHeader.astro';
import { AUTHOR_NAME } from '../consts';

interface Props {
  title: string;
  projectId: string;
  status?: string;
  cover: {
    image: string;
    alt?: string;
    caption?: string;
  };
  meta: {
    category: string;
    format?: string;
    team?: string;
    institution?: string;
    year?: string;
  };
  description?: string;
}

const { title, projectId, cover, meta, description } = Astro.props;

// Compute project prev/next for header navigation
const allProjects = (await getCollection('projects', (p) => p.data.status !== 'hidden'))
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = allProjects.findIndex((p) => p.id === projectId);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

const metaParts = [meta.institution, meta.format, meta.year].filter(Boolean);
---

<BaseLayout title={`${title} — ${AUTHOR_NAME}`} description={description ?? title}>
  <BlogHeader
    slot="header"
    prevHref={prevProject ? `/projects/${prevProject.id}` : undefined}
    nextHref={nextProject ? `/projects/${nextProject.id}` : undefined}
  />

  {cover.image && (
    <div class="w-full">
      <img
        src={`/image/${cover.image}.jpg`}
        alt={cover.alt ?? ''}
        class="w-full h-auto"
        loading="eager"
        onerror="this.style.display='none'"
      />
      {cover.caption && (
        <p class="text-sm text-zinc-400 px-7 mt-2">{cover.caption}</p>
      )}
    </div>
  )}

  <div class="max-w-screen-2xl mx-auto px-7 pt-8 pb-4 border-b border-zinc-100">
    <h1 class="font-serif-display text-4xl md:text-5xl lg:text-6xl mb-4">{title}</h1>
    <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-zinc-500">
      {metaParts.map((part) => (
        <span>{part}</span>
      ))}
    </div>
  </div>

  <main class="max-w-screen-2xl mx-auto px-7 pt-8 pb-20 flex flex-col gap-12">
    <slot />
  </main>
</BaseLayout>
