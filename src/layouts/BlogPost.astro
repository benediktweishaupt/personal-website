---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogNavigation from '../components/BlogNavigation.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	currentPostId?: string;
};

const { title, description, pubDate, updatedDate, heroImage, currentPostId } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="min-h-screen bg-slate-50">
		<BlogHeader currentPostId={currentPostId} />
		<BlogNavigation currentPostId={currentPostId} />
		
		<!-- Main content -->
		<main>
				<article class="max-w-7xl mx-auto p-8">
					<header class="pb-8">
						<h1 class="font-serif text-9xl leading-none tracking-tighter font-normal mb-8 text-gray-800">{title}</h1>
						<p class="text-xl font-medium text-gray-800 tracking-wide">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="italic block">
										Last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</p>					
					</header>
					<!-- {heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="rounded mb-8" />} -->
					<div class="prose prose-lg max-w-none leading-relaxed font-serif text-xl font-normal">
						<slot />
					</div>
				</article>
		</main>
		
		<Footer />

	</body>
</html>