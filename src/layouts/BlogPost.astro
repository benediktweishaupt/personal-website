---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogHeader from '../components/BlogHeader.astro';
import BlogNavigation from '../components/BlogNavigation.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	currentPostId?: string;
};

const { title, description, pubDate, updatedDate, heroImage, currentPostId } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="min-h-screen bg-slate-50">
		<BlogHeader currentPostId={currentPostId} />
		<BlogNavigation currentPostId={currentPostId} />
		
		<!-- Main content -->
		<main>
			<div class="max-w-4xl mx-auto px-6 py-8">
				<article class="max-w-3xl mx-auto">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" class="rounded mb-8" />}
					<header class="mb-8">
						<p class="text-sm text-gray-600 mb-4">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="italic block">
										Last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</p>
						<h1 class="text-3xl font-bold mb-4 text-gray-900">{title}</h1>
						<hr class="border-gray-300" />
					</header>
					<div class="prose prose-lg max-w-none prose-gray">
						<slot />
					</div>
				</article>
			</div>
		</main>
		
		<Footer />

	</body>
</html>