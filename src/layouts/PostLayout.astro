---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteHeader from '../components/SiteHeader.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	currentPostId?: string;
};

const { title, description, pubDate, updatedDate, currentPostId } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<SiteHeader slot="header" currentPostId={currentPostId} pageTitle={title} />

	<main class="max-w-screen-2xl mx-auto bg-slate-100">
		<article class="px-6 py-12">
			<header class="pb-24">
				<p class="inline text-base font-sans tracking-wide">
					<FormattedDate date={pubDate} />
				</p>
				<h1 class="inline font-serif-display md:text-8xl lg:text-9xl text-7xl leading-none tracking-tighter font-normal text-gray-800 ml-4">
					{title}
				</h1>
				{
					updatedDate && (
						<p class="text-sm italic mt-2">
							Last updated on <FormattedDate date={updatedDate} />
						</p>
					)
				}
			</header>

			<!-- Two-column layout container -->
			<section class="lg:flex lg:gap-8">
				<!-- Text content column -->
				<div class="lg:w-1/2">
					<div class="prose prose-lg max-w-none leading-relaxed font-sans">
						<slot />
					</div>
				</div>

				<!-- Images column - sticky on desktop, hidden on mobile -->
				<div class="lg:w-1/2 lg:sticky lg:top-8 lg:self-start hidden lg:block ">
					<div class="space-y-4" id="images-sidebar">
						<!-- Images will be moved here dynamically -->
					</div>
				</div>
			</section>

		</article>
	</main>

	<script>
		// Simply clone images to sidebar once on page load - CSS handles responsive visibility
		document.addEventListener('astro:page-load', () => {
			const sidebar = document.getElementById('images-sidebar');
			const proseContent = document.querySelector('.prose');

			if (!sidebar || !proseContent) return;

			const images = proseContent.querySelectorAll('img');
			images.forEach(img => {
				const clone = img.cloneNode(true);
				if (clone instanceof HTMLImageElement) {
					clone.className = 'w-full h-auto rounded';
					sidebar.appendChild(clone);
				}
			});
		});
	</script>
</BaseLayout>
