---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Archive | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="max-w-4xl mx-auto px-4">
		<Header />
		<main class="py-8">
			<h1 class="text-2xl font-bold mb-8">Archive</h1>
			<div class="space-y-6">
				{
					posts.map((post) => (
						<article class="border-b pb-4">
							<a href={`/blog/${post.slug}/`} class="block hover:opacity-80">
								<h2 class="text-lg font-medium mb-1">{post.data.title}</h2>
								<p class="text-sm text-gray-600">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</article>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

