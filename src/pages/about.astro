---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../consts';
---

<BaseLayout title={`About — ${AUTHOR_NAME}`} description="Benedikt Weishaupt — Product Designer.">
  <div class="bg-white text-gray-900">
    <article class="max-w-screen-md pt-8 pb-20 px-page">

      {/* ── Header ── */}
      <div class="text-xl pb-6 grid sm:grid-cols-2 gap-4">
        <div>
          <p>Benedikt Weishaupt</p>
          <p class="text-gray-400">Product Designer</p>
        </div>
        <div class="space-y-1">
          <p><a href="mailto:mail@benediktweishaupt.de" class="underline underline-offset-4 decoration-gray-400 hover:decoration-gray-900 transition-colors">mail@benediktweishaupt.de</a></p>
          <p class="text-gray-400 flex gap-3">
            <a href="https://linkedin.com/in/benedikt-weishaupt" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-gray-400 hover:decoration-gray-900 hover:text-gray-900 transition-colors">LinkedIn</a>
            <a href="https://github.com/benediktweishaupt" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-gray-400 hover:decoration-gray-900 hover:text-gray-900 transition-colors">GitHub</a>
            <a href="https://benediktweishaupt.github.io/jitsi-bitsi-spider/" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-gray-400 hover:decoration-gray-900 hover:text-gray-900 transition-colors">Jitsi Bitsi Spider</a>
          </p>
        </div>
      </div>

      {/* ── Core text — always visible ── */}
      <div class="text-xl pb-6 space-y-4">
        <p>I build design systems and help teams make them their own. Currently at the learning platform Reteach. Before that for the German fashion brand Closed.</p>
        <p>I've been preaching and questioning algorithmic design at European institutions for over a decade.</p>
        <p>When I'm not building component libraries, I make films about image stitching and inpainting algorithms.</p>
      </div>

      <!-- {/* ── Toggle ── */}
      <div class="flex gap-2 pb-6" id="about-toggle">
        <button data-view="clients" class="about-pill rounded-full px-3 py-1 text-sm transition-colors cursor-pointer">Clients</button>
        <button data-view="research" class="about-pill rounded-full px-3 py-1 text-sm transition-colors cursor-pointer">Research</button>
        <button data-view="teaching" class="about-pill rounded-full px-3 py-1 text-sm transition-colors cursor-pointer">Teaching</button>
      </div>

      {/* ── Expandable: Clients ── */}
      <div id="about-clients" class="text-xl pb-6 space-y-4 hidden">
        <p>I tend to join companies during transitions — rebrands, tech stack migrations, the moment when what worked before stops scaling. At Reteach I built the design system and Vue component infrastructure that turned a single-engineer bottleneck into shared ownership across four frontend developers. At Closed I set up design from scratch after the rebrand: token pipelines syncing Figma decisions through GitHub Actions to Storybook, WCAG 2.1 AA across all interfaces.</p>
        <p>Before that: Museum Utopie und Alltag (funded by Kulturstiftung des Bundes), SunExpress (Lufthansa Group), Mister Spex, wirDesign, Schwules Museum Berlin. I work best when there's a mess to untangle and a team willing to build infrastructure together.</p>
      </div>

      {/* ── Expandable: Research ── */}
      <div id="about-research" class="text-xl pb-6 space-y-4 hidden">
        <p>Moving Membranes (2018–2020) investigated how the European Border and Coast Guard Agency produces, circulates, and legitimises images — funded by Creative Industries Fund NL, presented at Video Vortex Malta (Geert Lovink), Forecast Forum Berlin (Paolo Cirio), and London College of Communication (with Susan Schuppli). With the Design Displacement Group I built multi-screen installations for the Brno Biennial, Graphic Design Festival Scotland, and the Biennale de Chaumont.</p>
        <p>The work sits between media forensics and graphic design — scripts that scrape, sort, and recombine institutional image archives into new readings.</p>
      </div>

      {/* ── Expandable: Teaching ── */}
      <div id="about-teaching" class="text-xl pb-6 space-y-4 hidden">
        <p>Five years at Weißensee Academy of Art Berlin (2016–2021), plus workshops and seminars at Jan van Eyck Academy Maastricht, KABK Den Haag, London College of Communication, BTK Berlin, and École supérieure d'art Cambrai. I teach designers to treat code as material: web scraping as research method, generative layout as argument, collective authorship as default.</p>
        <p>Courses ranged from "All Watched Over by Machines of Loving Grace" (with Prof. Barbara Junge and Rijksmuseum Amsterdam) to the "Digital Campfire" workshop series across four European countries. Over 50 supervised thesis projects. Teaching and designing are the same activity — you build a system and then watch what people do with it.</p>
      </div> -->

    </article>
  </div>

</BaseLayout>

<style>
  .about-pill {
    @apply text-gray-400 bg-transparent border border-gray-400;
  }
  .about-pill:hover {
    @apply text-gray-900 border-gray-900;
  }
  .about-pill.active {
    @apply text-gray-900 bg-white border-gray-900;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pills = document.querySelectorAll<HTMLElement>('.about-pill');
    const sections: Record<string, HTMLElement | null> = {
      clients: document.getElementById('about-clients'),
      research: document.getElementById('about-research'),
      teaching: document.getElementById('about-teaching'),
    };

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const view = pill.dataset.view;
        const wasActive = pill.classList.contains('active');

        // Reset all
        pills.forEach(p => p.classList.remove('active'));
        Object.values(sections).forEach(s => s?.classList.add('hidden'));

        // Toggle: click active pill to close, click inactive to open
        if (!wasActive && view && sections[view]) {
          pill.classList.add('active');
          sections[view]!.classList.remove('hidden');
        }
      });
    });
  });
</script>
