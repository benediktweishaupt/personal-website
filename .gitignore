# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# image staging (large unprocessed files)
docs/images-to-place/

# personal and strategic documents — this repo is public
# reference-data holds the CV (address, date of birth) and the portfolio PDF;
# PRD and research notes are working documents, not portfolio content
docs/reference-data/
PRD.md
docs/research-unterwegs.txt

# local agent config (machine paths, permission settings)
.claude/

# fonts — licensed binaries, never commit
# served on bewe.is under license, but not redistributable (Displaay §06/§10)
# provided at build time from the private assets repo, see .github/workflows/deploy.yml
public/fonts/*.woff
public/fonts/*.woff2
public/fonts/*.otf
public/fonts/*.ttf

# font purchases and foundry trials (licence docs, invoices, trial families)
docs/DP_*/

# video source files — only the converted .mp4 ships (see docs/conventions/media-assets.md)
*.mov

# editor/scratch leftovers
*.bak
